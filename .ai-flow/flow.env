# AI flow configuration — non-secret values only (this repository is public).
#
# Sourced by scripts/ai-flow/*.sh and by the ai-* workflows. Plain KEY=VALUE lines, quote
# values containing spaces or brackets. Secrets live in the repository secrets:
# CLAUDE_CODE_OAUTH_TOKEN, AI_FLOW_APP_ID, AI_FLOW_APP_PRIVATE_KEY. The list of PM logins
# lives in the repository variable AI_FLOW_PM_LOGINS.

# Repository and branches
AI_FLOW_REPO=getisolated/daftr
AI_FLOW_MAIN_BRANCH=main
AI_FLOW_INTEGRATION_BRANCH=integration
AI_FLOW_BRANCH_PREFIX=ai/
AI_FLOW_RUNS_DIR=.ai-flow/runs

# GitHub App of the flow (public identifiers, not secrets). The bot login is used by the
# router to recognise and ignore its own events.
AI_FLOW_APP_SLUG=daftr-ai-flow
AI_FLOW_APP_ID=5579737
AI_FLOW_BOT_LOGIN="daftr-ai-flow[bot]"

# Loop limits: question rounds at the specs step, review -> code round trips, PM returns
# (ai:problème -> plan). Past the limit the flow escalates to the PM (ai:escalade).
AI_FLOW_MAX_SPEC_ROUNDS=3
AI_FLOW_MAX_REVIEW_LOOPS=3
AI_FLOW_MAX_PM_RETURNS=3

# Turn budgets (--max-turns) per agent
AI_FLOW_TURNS_SPECS=15
AI_FLOW_TURNS_PLAN=25
AI_FLOW_TURNS_TESTS=40
AI_FLOW_TURNS_CODE=80
AI_FLOW_TURNS_REVIEW=30
AI_FLOW_TURNS_DOCS=25
AI_FLOW_TURNS_DEPLOY=15

# Models per agent (Claude Code aliases: always the latest model of the family)
AI_FLOW_MODEL_SPECS=sonnet
AI_FLOW_MODEL_PLAN=opus
AI_FLOW_MODEL_TESTS=sonnet
AI_FLOW_MODEL_CODE=opus
AI_FLOW_MODEL_REVIEW=opus
AI_FLOW_MODEL_DOCS=sonnet
AI_FLOW_MODEL_DEPLOY=sonnet

# Status checks required by the rulesets (comma-separated job names).
# main: the existing CI (ci.yml) on pull requests. integration: the fast check of the flow
# (ai-ci.yml, job name `ai-ci-check`, added in a later batch).
AI_FLOW_MAIN_REQUIRED_CHECKS="Tests Angular et Rust (windows-latest),Tests Angular et Rust (macos-latest)"
AI_FLOW_INTEGRATION_REQUIRED_CHECKS="ai-ci-check"

# Test builds ("Daftr Test", installed side by side with the real app)
AI_FLOW_TEST_IDENTIFIER=com.daftr.app.test
AI_FLOW_TEST_PRODUCT_NAME="Daftr Test"
